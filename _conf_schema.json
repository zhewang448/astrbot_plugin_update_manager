{
  "schedule_mode": {
    "description": "定时检查方式",
    "type": "string",
    "options": [
      "interval",
      "calendar"
    ],
    "labels": [
      "方式 1：固定间隔",
      "方式 2：指定星期和时间"
    ],
    "hint": "方式 1 保持原有行为；方式 2 可选择每周哪些天、每天哪些时间检查",
    "default": "interval"
  },
  "interval_hours": {
    "description": "固定检查间隔（小时）",
    "type": "float",
    "hint": "AstrBot 启动后每隔 N 小时检查一次，可为浮点数；填 0 则停用定时检查",
    "default": 24,
    "condition": {
      "schedule_mode": "interval"
    }
  },
  "check_weekdays": {
    "description": "每周检查日期",
    "type": "list",
    "options": [
      "mon",
      "tue",
      "wed",
      "thu",
      "fri",
      "sat",
      "sun"
    ],
    "labels": [
      "星期一",
      "星期二",
      "星期三",
      "星期四",
      "星期五",
      "星期六",
      "星期日"
    ],
    "hint": "可搜索并多选；至少选择一天",
    "default": [
      "mon",
      "tue",
      "wed",
      "thu",
      "fri",
      "sat",
      "sun"
    ],
    "condition": {
      "schedule_mode": "calendar"
    }
  },
  "check_times": {
    "description": "每日检查时间",
    "type": "list",
    "hint": "可填写多个时间，每项使用 24 小时制 HH:MM，例如 04:00、16:30",
    "default": [
      "04:00"
    ],
    "condition": {
      "schedule_mode": "calendar"
    }
  },
  "check_on_startup": {
    "description": "启动后立即检查一次",
    "type": "bool",
    "hint": "仅用于方式 2；不会补跑启动前错过的任务",
    "default": false,
    "condition": {
      "schedule_mode": "calendar"
    }
  },
  "admin_sid_list": {
    "description": "管理员 SID 列表",
    "type": "list",
    "hint": "定时检查结束后向这些会话发送结果；可在对应会话发送 /sid 获取",
    "default": []
  },
  "github_proxy": {
    "description": "GitHub 加速地址",
    "type": "string",
    "hint": "例如 https://gh-proxy.com，不填则不使用；市场 download_url 可用时会优先使用市场安装包",
    "default": ""
  },
  "github_token": {
    "description": "GitHub API Token",
    "type": "string",
    "hint": "可选；填写 GitHub Personal Access Token（PAT）后用于提高 API 限额，建议使用最小权限 Token；留空则使用匿名请求",
    "default": ""
  },
  "custom_plugin_sources": {
    "description": "自定义插件更新源",
    "type": "template_list",
    "hint": "绑定未进入插件市场的 GitHub 插件；绑定后该插件优先使用自定义源",
    "default": [],
    "templates": {
      "github_metadata": {
        "name": "GitHub metadata.yaml",
        "hint": "从指定仓库读取 metadata.yaml 或 metadata.yml 中的版本",
        "display_item": "repo",
        "items": {
          "plugin": {
            "description": "本地插件",
            "type": "list",
            "options": [],
            "labels": [],
            "hint": "搜索并选择一个已安装插件；每条绑定只能选择一个",
            "default": []
          },
          "repo": {
            "description": "GitHub 仓库",
            "type": "string",
            "hint": "格式：https://github.com/owner/repo",
            "default": ""
          },
          "branch": {
            "description": "分支",
            "type": "string",
            "hint": "留空则自动使用仓库默认分支",
            "default": ""
          }
        }
      }
    }
  },
  "white_plugin_list": {
    "description": "白名单插件",
    "type": "list",
    "options": [],
    "labels": [],
    "hint": "可搜索并多选；非空时只检查选中的插件",
    "default": []
  },
  "black_plugin_list": {
    "description": "黑名单插件",
    "type": "list",
    "options": [],
    "labels": [],
    "hint": "可搜索并多选；测试分支或不希望自动更新的插件请加入黑名单",
    "default": []
  },
  "restart_mode": {
    "description": "更新成功后重启 AstrBot",
    "type": "bool",
    "default": false
  },
  "test_mode": {
    "description": "测试模式",
    "type": "bool",
    "hint": "在插件目录的 test.md 中输出本地插件、市场数据和匹配结果",
    "default": false,
    "invisible": false
  }
}
