{
  "plugin_updates": {
    "description": "插件更新",
    "type": "object",
    "items": {
      "schedule_mode": {"description": "定时方式", "type": "string", "options": ["interval", "calendar"], "labels": ["固定间隔", "指定星期和时间"], "hint": "选择插件更新任务的调度方式。", "default": "interval"},
      "interval_hours": {"description": "固定检查间隔（小时）", "type": "float", "hint": "每隔 N 小时检查一次；填 0 可停用插件定时任务。", "default": 24, "condition": {"schedule_mode": "interval"}},
      "check_weekdays": {"description": "每周检查日期", "type": "list", "options": ["mon", "tue", "wed", "thu", "fri", "sat", "sun"], "labels": ["星期一", "星期二", "星期三", "星期四", "星期五", "星期六", "星期日"], "hint": "日历方式下选择一个或多个星期。", "default": ["mon", "tue", "wed", "thu", "fri", "sat", "sun"], "condition": {"schedule_mode": "calendar"}},
      "check_times": {"description": "每日检查时间", "type": "list", "hint": "日历方式下填写 HH:MM，例如 04:00、16:30。", "default": ["04:00"], "condition": {"schedule_mode": "calendar"}},
      "check_on_startup": {"description": "启动后立即检查", "type": "bool", "hint": "日历方式下，AstrBot 启动后额外检查一次。", "default": false, "condition": {"schedule_mode": "calendar"}},
      "auto_update": {"description": "定时发现更新后自动更新", "type": "bool", "hint": "关闭后只检查并通知，不更新插件或触发重启。", "default": true},
      "restart_mode": {"description": "插件更新成功后重启", "type": "bool", "hint": "定时或手动更新成功后是否重启 AstrBot。", "default": false},
      "send_changelog_to_admin": {"description": "更新成功后发送日志", "type": "bool", "hint": "向管理员发送插件 CHANGELOG；仅发送存在日志的插件。", "default": false},
      "custom_plugin_sources": {"description": "自定义 GitHub 更新源", "type": "template_list", "hint": "为未上架插件绑定 GitHub 仓库；绑定后优先使用自定义源。", "default": [], "templates": {"github_metadata": {"name": "GitHub metadata.yaml", "hint": "从仓库读取 metadata.yaml 或 metadata.yml 中的版本。", "display_item": "repo", "items": {"plugin": {"description": "本地插件", "type": "list", "options": [], "labels": [], "hint": "搜索并选择一个已安装插件。", "default": []}, "repo": {"description": "GitHub 仓库", "type": "string", "hint": "格式：https://github.com/owner/repo。", "default": ""}, "branch": {"description": "分支", "type": "string", "hint": "留空则使用仓库默认分支。", "default": ""}}}}},
      "white_plugin_list": {"description": "白名单插件", "type": "list", "options": [], "labels": [], "hint": "非空时只检查选中的插件。", "default": []},
      "black_plugin_list": {"description": "黑名单插件", "type": "list", "options": [], "labels": [], "hint": "跳过选中的插件；黑名单优先于白名单。", "default": []}
    }
  },
  "framework_updates": {
    "description": "AstrBot 框架更新",
    "type": "object",
    "items": {
      "enabled": {"description": "启用框架更新功能", "type": "bool", "hint": "关闭后框架检查、更新和定时任务均停用；手动重启不受影响。", "default": true},
      "schedule_enabled": {"description": "启用框架定时检查", "type": "bool", "hint": "开启后按下方时间表检查 AstrBot 更新；兼容旧版 astrbot_auto_update。", "default": false},
      "auto_update": {"description": "定时发现更新后自动更新", "type": "bool", "hint": "关闭后定时任务只检查并通知，不下载更新或重启。", "default": true},
      "schedule_mode": {"description": "定时方式", "type": "string", "options": ["interval", "calendar"], "labels": ["固定间隔", "指定星期和时间"], "hint": "选择框架定时任务的调度方式。", "default": "interval", "condition": {"schedule_enabled": true}},
      "interval_hours": {"description": "固定检查间隔（小时）", "type": "float", "hint": "每隔 N 小时检查一次；填 0 可停用框架定时任务。", "default": 24, "condition": {"schedule_enabled": true, "schedule_mode": "interval"}},
      "check_weekdays": {"description": "每周检查日期", "type": "list", "options": ["mon", "tue", "wed", "thu", "fri", "sat", "sun"], "labels": ["星期一", "星期二", "星期三", "星期四", "星期五", "星期六", "星期日"], "hint": "日历方式下选择一个或多个星期。", "default": ["mon", "tue", "wed", "thu", "fri", "sat", "sun"], "condition": {"schedule_enabled": true, "schedule_mode": "calendar"}},
      "check_times": {"description": "每日检查时间", "type": "list", "hint": "日历方式下填写 HH:MM，例如 04:00、16:30。", "default": ["04:00"], "condition": {"schedule_enabled": true, "schedule_mode": "calendar"}},
      "check_on_startup": {"description": "启动后立即检查", "type": "bool", "hint": "日历方式下，AstrBot 启动后额外检查一次。", "default": false, "condition": {"schedule_enabled": true, "schedule_mode": "calendar"}},
      "include_prerelease": {"description": "检查预发布版本", "type": "bool", "hint": "将高于当前版本的预发布版本纳入检查和更新。", "default": false, "condition": {"enabled": true}},
      "changelog_forward_threshold": {"description": "更新日志转发阈值（字）", "type": "int", "hint": "超过该字数时使用合并转发；填 0 表示所有非空日志均转发。", "default": 100, "condition": {"enabled": true}},
      "send_changelog_to_admin": {"description": "更新成功后发送日志", "type": "bool", "hint": "向管理员发送 AstrBot 发布版本的更新日志。", "default": true, "condition": {"enabled": true}}
    }
  },
  "notifications": {
    "description": "通知",
    "type": "object",
    "items": {
      "admin_sid_list": {"description": "管理员会话 SID", "type": "list", "hint": "接收定时检查结果和更新日志；可在会话中发送 /sid 获取。", "default": []},
      "update_report_fields": {"description": "更新汇报字段", "type": "list", "options": ["display_name", "plugin_id", "version", "repository_url", "author"], "labels": ["插件名称", "插件 ID", "版本变化", "仓库链接", "作者"], "hint": "用于发现更新时的插件列表；字段按固定顺序显示。", "default": ["display_name", "plugin_id", "version"]}
    }
  },
  "network": {
    "description": "网络",
    "type": "object",
    "items": {
      "github_proxy": {"description": "GitHub 加速地址", "type": "string", "hint": "例如 https://gh-proxy.com；留空则不使用。", "default": ""},
      "github_token": {"description": "GitHub API Token", "type": "string", "hint": "可选，用于提高 GitHub API 限额。", "secret": true, "default": ""}
    }
  },
  "debug": {
    "description": "调试",
    "type": "object",
    "items": {"test_mode": {"description": "测试模式", "type": "bool", "hint": "在插件目录输出本地插件、市场数据和匹配结果。", "default": false}}
  },
